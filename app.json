{
  "expo": {
    "name": "Evarna",
    "slug": "evarna",
    "scheme": "evarna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F111A",
    "newArchEnabled": false,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.evarna.companion",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Evarna needs your microphone to let you talk to your companion during voice calls.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSLocalNetworkUsageDescription": "$(PRODUCT_NAME) uses your local network to find the most direct connection for voice calls.",
        "NSCameraUsageDescription": "$(PRODUCT_NAME) never uses your camera. Its voice-calling component includes camera support, and iOS requires a description for it even though the app never asks."
      },
      "bitcode": false
    },
    "android": {
      "package": "app.evarna.companion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F111A"
      },
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F111A"
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "@react-native-google-signin/google-signin",
      "expo-notifications"
    ]
  }
}
