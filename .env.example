# Evarna Frontend — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# Backend URL — set this for your environment:
#   iOS Simulator (Mac):   http://localhost:3000
#   Android Emulator:      http://10.0.2.2:3000
#   Physical device (LAN): http://<your-machine-LAN-IP>:3000
#   Staging:               https://api-staging.evarna.app
#   Production:            https://api.evarna.app
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── Google Sign-In ──────────────────────────────────────────────────────────
# From Google Cloud Console → Credentials. Create THREE OAuth client ids.
#
# The WEB client id is required even though this is a native app: the library
# exchanges the native sign-in for an ID token whose audience is the web client,
# and that is what the backend verifies. Configuring only the iOS/Android ids
# produces a token the server rejects — the single most common way this fails.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android needs no id here — it is matched by package name + SHA-1 fingerprint
# registered in the console. Register the fingerprint of EVERY signing key:
# debug, EAS, and Play App Signing are three different keys and each one that
# is not registered fails on that build only.
#
# Changing either value above requires a NEW dev build, not just a restart:
# the iOS URL scheme is derived from the iOS client id at build time
# (see app.config.js).

# ── Legal ───────────────────────────────────────────────────────────────────
# Hosted privacy policy and terms. Required by both app stores; Settings opens
# these, and says "not published yet" when they are unset.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
